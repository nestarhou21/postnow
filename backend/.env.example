# ── API Keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_string_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────────────
DATABASE_URL=postnow.db

# ── Image generation ──────────────────────────────────────
# Set true to skip Gemini API and return a placeholder poster (for UI testing)
MOCK_IMAGE_GENERATION=true

# ── ML / Caption model ────────────────────────────────────
# Set USE_LOCAL_MODEL=true to use a fine-tuned local model.
# Set to false to always use the Claude API fallback.
USE_LOCAL_MODEL=false

# Which local model to load: "mbart" or "gemma"
#   mbart → ml/infer.py       (train with ml/train.py)
#   gemma → ml/infer_gemma.py (train with ml/POSTNOW_Gemma4_Finetune.ipynb)
LOCAL_MODEL_TYPE=mbart

# Path to the trained model/adapter weights (relative to project root)
#   mBART example : ml/model/final
#   Gemma example : ml/model/gemma_postnow/lora_adapter
LOCAL_MODEL_PATH=ml/model/final

CONFIDENCE_THRESHOLD=0.4
